<script>
  try {

    var searchInput = document.getElementById("searchInput");

    var rows = Array.prototype.slice.call(
      document.querySelectorAll("#dictBody tr")
    );

    var resultCount = document.getElementById("resultCount");

    var noResults = document.getElementById("noResults");

    var filterRadios = Array.prototype.slice.call(
      document.querySelectorAll('input[name="filter"]')
    );

    function clearInlineDisplay() {
      rows.forEach(function (r) {
        r.style.display = "";
      });
    }

    function countForChecked() {

      var checked = document.querySelector(
        'input[name="filter"]:checked'
      );

      if (!checked) return rows.length;

      if (checked.id === "filter-all") {
        return rows.length;
      }

      var label = document.querySelector(
        'label[for="' + checked.id + '"]'
      );

      var val = label
        ? label.textContent.trim()
        : "";

      var attr =
        checked.id.indexOf("filter-letter-") === 0
          ? "data-letter"
          : "data-cat";

      return rows.filter(function (r) {
        return r.getAttribute(attr) === val;
      }).length;
    }

    function updateCountDisplay(n) {

      if (resultCount) {
        resultCount.textContent =
          n + (n === 1 ? " word" : " words");
      }

      if (noResults) {
        noResults.style.display =
          n ? "none" : "block";
      }
    }

    if (searchInput) {

      searchInput.addEventListener("input", function () {

        var term =
          this.value.trim().toLowerCase();

        var allRadio =
          document.getElementById("filter-all");

        if (allRadio) {
          allRadio.checked = true;
        }

        var visible = 0;

        rows.forEach(function (row) {

          var match =
            !term ||
            row.textContent
              .toLowerCase()
              .indexOf(term) > -1;

          row.style.display =
            match ? "" : "none";

          if (match) {
            visible++;
          }

        });

        updateCountDisplay(visible);

      });

    }

    var letterPrefix = "";

    function filterByLetterPrefix(prefix) {

      letterPrefix =
        prefix.toLowerCase();

      if (searchInput) {
        searchInput.value = "";
      }

      var visible = 0;

      rows.forEach(function (row) {

        var wordCell =
          row.querySelector(".word-cell");

        var word =
          wordCell
            ? wordCell.textContent
                .trim()
                .toLowerCase()
            : "";

        var match =
          !letterPrefix ||
          word.indexOf(letterPrefix) === 0;

        row.style.display =
          match ? "" : "none";

        if (match) {
          visible++;
        }

      });

      updateCountDisplay(visible);
    }

    filterRadios.forEach(function (radio) {

      radio.addEventListener("change", function () {

        var label =
          document.querySelector(
            'label[for="' + this.id + '"]'
          );

        var isLetter =
          this.id.indexOf("filter-letter-") === 0;

        if (isLetter) {

          var letter =
            label
              ? label.textContent.trim()
              : "";

          filterByLetterPrefix(
            letterPrefix + letter
          );

        } else {

          letterPrefix = "";

          if (searchInput) {
            searchInput.value = "";
          }

          clearInlineDisplay();

          updateCountDisplay(
            countForChecked()
          );
        }

      });

    });

    var allLabel =
      document.querySelector(
        'label[for="filter-all"]'
      );

    if (allLabel) {

      allLabel.addEventListener(
        "click",
        function () {

          letterPrefix = "";

          clearInlineDisplay();

          updateCountDisplay(
            rows.length
          );

        }
      );

    }

    updateCountDisplay(rows.length);

  } catch (e) {

  }
</script>

