{
  "language": "Yuloush",
  "type": "constructed_language",
  "description": "A class-created constructed language.",
  "source": "https://github.com/solnervr-cmyk/Yuloush-language",
  "grammar": {
    "plural": {
      "rule": "Add 'a' to the end of a word to make it plural.",
      "examples": {
        "Casen": "Cat",
        "Casena": "Cats"
      }
    },
    "baby_animals": {
      "rule": "Use 'e' for one baby animal and 'ea' for more than one.",
      "examples": {
        "Casene": "Kitten",
        "Casenea": "Kittens",
        "Pasene": "Puppy",
        "Pasenea": "Puppies"
      }
    }
  },
